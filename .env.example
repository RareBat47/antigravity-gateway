# ==============================================================================
# Antigravity Gateway Environment Variables
# ==============================================================================

# Server Network Settings
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8999
GATEWAY_DEBUG=false

# Security & Authentication
# Secret key used to encrypt OAuth refresh tokens at rest (Fernet AES-256)
# If left blank, a secure random key is auto-generated in data/vault.key
GATEWAY_ENCRYPTION_KEY=

# Public OpenAI-compatible API Key (used by Hermes / clients)
GATEWAY_API_KEY=agw-hermes-secret-key-change-me

# Admin API Key (used for managing accounts, viewing sensitive health & quota)
ADMIN_API_KEY=agw-admin-super-secret-key-change-me

# Google OAuth2 Client Configuration (Defaults to standard Antigravity credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public Base URL (Used for remote OAuth redirect callbacks if accessed over domain/tunnel)
# Example: https://gateway.yourdomain.com
PUBLIC_BASE_URL=

# Paths
DATABASE_PATH=data/gateway.db
QUOTA_STATE_PATH=data/quota-state.json
STATUS_REPORT_PATH=docs/account-status.md

# Quota & Scheduling Tuning
QUOTA_POLL_INTERVAL_SECONDS=300
QUOTA_STALE_THRESHOLD_SECONDS=600
GLOBAL_QUOTA_THRESHOLD=0.05
MAX_ACCOUNT_RETRIES=3
DEFAULT_COOLDOWN_SECONDS=60
